# Copy to .env.local for local dev.
# On Vercel: Settings → Environment Variables (Production + Preview).
# Never commit real keys.

# Required for LLM-phrased answers. Without it, grounded pack fallback still works.
XAI_API_KEY=

# Optional hybrid RAG (pgvector + trgm extras). Pack-only if omitted.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. 0 = pack-only kill switch. Omit or 1 when Supabase keys are set.
HYBRID_RAG=0

# Optional. 768-d embeddings for pack_docs only — not used for chat replies.
# GEMINI_API_KEY=
