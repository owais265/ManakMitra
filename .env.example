# Copy to .env.local for local development.
# On Vercel: Settings → Environment Variables (Production + Preview).
# Never commit real keys.

# Chat LLM (optional). Runtime uses XAI_API_KEY first, then XAI_API_KEY_2.
# If xAI fails, GEMINI_API_KEY is used for phrasing only (same evidence pack).
XAI_API_KEY=
# XAI_API_KEY_2=
# XAI_MODEL=grok-3-mini

# Optional hybrid RAG (pgvector + trgm extras). Pack-only if omitted.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. 0 = pack-only kill switch. Omit or 1 when Supabase keys are set.
HYBRID_RAG=0

# Optional. Phrasing fallback if xAI is down, and 768-d embeddings for ingest.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
